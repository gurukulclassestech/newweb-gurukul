{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global institute branding, about narrative, courses page copy, WhatsApp button, popup, contact, SEO, payment, and legal settings.",
      "type": "object",
      "properties": {
        "institute_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 400 },
        "about_heading": { "type": "string", "maxLength": 200 },
        "about_intro": { "type": "string", "maxLength": 600 },
        "about_mission": { "type": "string", "maxLength": 400 },
        "about_story": { "type": "string", "maxLength": 8000 },
        "about_highlights": { "type": "array" },
        "courses_eyebrow": { "type": "string", "maxLength": 100 },
        "courses_title": { "type": "string", "maxLength": 200 },
        "courses_description": { "type": "string", "maxLength": 600 },
        "courses_badge": { "type": "string", "maxLength": 160 },
        "courses_category_descriptions": { "type": "array" },
        "courses_approach_eyebrow": { "type": "string", "maxLength": 100 },
        "courses_approach_title": { "type": "string", "maxLength": 200 },
        "courses_approach_description": { "type": "string", "maxLength": 600 },
        "courses_approach_steps": { "type": "array" },
        "logo_url": { "type": "string", "maxLength": 1000 },
        "logo_width": { "type": "string", "maxLength": 10 },
        "logo_height": { "type": "string", "maxLength": 10 },
        "favicon_url": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "whatsapp_float_enabled": { "type": "boolean" },
        "whatsapp_prefill_message": { "type": "string", "maxLength": 300 },
        "address": { "type": "string", "maxLength": 300 },
        "map_embed_url": { "type": "string", "maxLength": 1000 },
        "map_link": { "type": "string", "maxLength": 1000 },
        "office_hours": { "type": "string", "maxLength": 160 },
        "announcement_enabled": { "type": "boolean" },
        "announcement_text": { "type": "string", "maxLength": 300 },
        "announcement_bg_color": { "type": "string", "maxLength": 20 },
        "announcement_text_color": { "type": "string", "maxLength": 20 },
        "header_bg_color": { "type": "string", "maxLength": 20 },
        "header_text_color": { "type": "string", "maxLength": 20 },
        "footer_about": { "type": "string", "maxLength": 400 },
        "footer_copyright": { "type": "string", "maxLength": 200 },
        "facebook_url": { "type": "string", "maxLength": 500 },
        "instagram_url": { "type": "string", "maxLength": 500 },
        "youtube_url": { "type": "string", "maxLength": 500 },
        "twitter_url": { "type": "string", "maxLength": 500 },
        "seo_title": { "type": "string", "maxLength": 160 },
        "seo_description": { "type": "string", "maxLength": 320 },
        "seo_keywords": { "type": "string", "maxLength": 300 },
        "og_image_url": { "type": "string", "maxLength": 1000 },
        "popup_enabled": { "type": "boolean" },
        "popup_title": { "type": "string", "maxLength": 160 },
        "popup_body": { "type": "string", "maxLength": 500 },
        "popup_cta_label": { "type": "string", "maxLength": 60 },
        "popup_cta_link": { "type": "string", "maxLength": 200 },
        "popup_submit_label": { "type": "string", "maxLength": 80 },
        "popup_image_url": { "type": "string", "maxLength": 1000 },
        "popup_delay_seconds": { "type": "number" },
        "popup_frequency": { "type": "string", "enum": ["session", "once", "always"] },
        "popup_show_parent_name": { "type": "boolean" },
        "popup_show_email": { "type": "boolean" },
        "popup_show_class": { "type": "boolean" },
        "popup_show_course": { "type": "boolean" },
        "popup_show_batch": { "type": "boolean" },
        "popup_show_message": { "type": "boolean" },
        "payments_enabled": { "type": "boolean" },
        "payment_fee_label": { "type": "string", "maxLength": 120 },
        "upi_id": { "type": "string", "maxLength": 120 },
        "payment_qr_url": { "type": "string", "maxLength": 1000 },
        "bank_details": { "type": "string", "maxLength": 600 },
        "payment_instructions": { "type": "string", "maxLength": 600 },
        "header_cta_enabled": { "type": "boolean" },
        "header_cta_label": { "type": "string", "maxLength": 60 },
        "header_cta_link": { "type": "string", "maxLength": 200 },
        "float_apply_enabled": { "type": "boolean" },
        "float_apply_label": { "type": "string", "maxLength": 60 },
        "float_apply_link": { "type": "string", "maxLength": 200 },
        "customized_modules": { "type": "array" },
        "privacy_content": { "type": "string", "maxLength": 5000 },
        "terms_content": { "type": "string", "maxLength": 5000 },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["institute_name", "phone", "email", "address"]
    },
    "NavItem": {
      "title": "NavItem",
      "description": "Header and footer navigation links.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "path": { "type": "string", "minLength": 1, "maxLength": 200 },
        "location": { "type": "string", "enum": ["header", "footer"] },
        "display_order": { "type": "number" },
        "open_in_new_tab": { "type": "boolean" }
      },
      "required": ["label", "path", "location", "display_order"]
    },
    "HomepageSection": {
      "title": "HomepageSection",
      "description": "Configurable ordered sections on the home, campus and about pages.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 40 },
        "eyebrow": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "body": { "type": "string", "maxLength": 4000 },
        "image_url": { "type": "string", "maxLength": 1000 },
        "button_label": { "type": "string", "maxLength": 80 },
        "button_link": { "type": "string", "maxLength": 200 },
        "display_order": { "type": "number" },
        "is_visible": { "type": "boolean" },
        "items": { "type": "array" }
      },
      "required": ["key", "display_order", "is_visible"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Hero admission banners.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "description": { "type": "string", "maxLength": 600 },
        "image_url": { "type": "string", "maxLength": 1000 },
        "mobile_image_url": { "type": "string", "maxLength": 1000 },
        "primary_label": { "type": "string", "maxLength": 60 },
        "primary_url": { "type": "string", "maxLength": 200 },
        "secondary_label": { "type": "string", "maxLength": 60 },
        "secondary_url": { "type": "string", "maxLength": 200 },
        "deadline": { "type": "string", "maxLength": 40 },
        "display_order": { "type": "number" },
        "is_active": { "type": "boolean" }
      },
      "required": ["title", "display_order", "is_active"]
    },
    "Course": {
      "title": "Course",
      "description": "Coaching courses and academic programs.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 160 },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 120 },
        "class_level": { "type": "string", "maxLength": 80 },
        "duration": { "type": "string", "maxLength": 80 },
        "target_exams": { "type": "string", "maxLength": 200 },
        "batch_info": { "type": "string", "maxLength": 160 },
        "subjects": { "type": "string", "maxLength": 300 },
        "fee": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 4000 },
        "highlights": { "type": "string", "maxLength": 2000 },
        "eligibility": { "type": "string", "maxLength": 1500 },
        "methodology": { "type": "string", "maxLength": 2000 },
        "exam_preparation": { "type": "string", "maxLength": 2000 },
        "admission_status": { "type": "string", "enum": ["open", "closing_soon", "closed"] },
        "image_url": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" },
        "is_featured": { "type": "boolean" }
      },
      "required": ["name", "category", "class_level", "is_published", "display_order"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Examination and test announcements.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "course_category": { "type": "string", "maxLength": 80 },
        "class_level": { "type": "string", "maxLength": 80 },
        "exam_date": { "type": "string", "maxLength": 40 },
        "exam_time": { "type": "string", "maxLength": 60 },
        "start_time": { "type": "string", "maxLength": 40 },
        "duration_minutes": { "type": "number" },
        "syllabus": { "type": "string", "maxLength": 1000 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["upcoming", "open", "completed", "closed"] },
        "registration_link": { "type": "string", "maxLength": 400 },
        "registration_url": { "type": "string", "maxLength": 400 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" }
      },
      "required": ["title", "status", "is_published", "display_order"]
    },
    "Lecture": {
      "title": "Lecture",
      "description": "Recorded video lectures for student revision.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "subject": { "type": "string", "maxLength": 80 },
        "class_level": { "type": "string", "maxLength": 80 },
        "teacher_name": { "type": "string", "maxLength": 100 },
        "duration": { "type": "string", "maxLength": 40 },
        "video_url": { "type": "string", "maxLength": 500 },
        "thumbnail_url": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 1500 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" }
      },
      "required": ["title", "subject", "class_level", "video_url", "is_published", "display_order"]
    },
    "StudentResult": {
      "title": "StudentResult",
      "description": "Verified student board and competitive results.",
      "type": "object",
      "properties": {
        "student_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "achievement_title": { "type": "string", "maxLength": 180 },
        "score": { "type": "string", "maxLength": 60 },
        "class_level": { "type": "string", "maxLength": 80 },
        "academic_year": { "type": "string", "maxLength": 30 },
        "photo_url": { "type": "string", "maxLength": 1000 },
        "document_url": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_featured": { "type": "boolean" },
        "is_published": { "type": "boolean" }
      },
      "required": ["student_name", "achievement_title", "score", "is_published", "display_order"]
    },
    "FacultyMember": {
      "title": "FacultyMember",
      "description": "Institute teachers and academic mentors.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "maxLength": 100 },
        "subjects": { "type": "string", "maxLength": 160 },
        "qualification": { "type": "string", "maxLength": 160 },
        "experience": { "type": "string", "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 1200 },
        "photo_url": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" }
      },
      "required": ["name", "role", "subjects", "is_published", "display_order"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Published student and parent testimonials.",
      "type": "object",
      "properties": {
        "display_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role_or_class": { "type": "string", "maxLength": 120 },
        "quote": { "type": "string", "minLength": 5, "maxLength": 1200 },
        "rating": { "type": "number" },
        "photo_url": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" }
      },
      "required": ["display_name", "quote", "rating", "is_published", "display_order"]
    },
    "GalleryAlbum": {
      "title": "GalleryAlbum",
      "description": "Gallery albums for organizing institute photographs.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "cover_image_url": { "type": "string", "maxLength": 1000 },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" }
      },
      "required": ["title", "is_published", "display_order"]
    },
    "GalleryMedia": {
      "title": "GalleryMedia",
      "description": "Photographs and media items in the institute gallery.",
      "type": "object",
      "properties": {
        "album_id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "caption": { "type": "string", "maxLength": 300 },
        "file_url": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "media_type": { "type": "string", "enum": ["image", "video"] },
        "display_order": { "type": "number" },
        "is_published": { "type": "boolean" }
      },
      "required": ["file_url", "media_type", "is_published", "display_order"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "News, academic notices, and study guidance articles.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 160, "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "maxLength": 80 },
        "author": { "type": "string", "maxLength": 100 },
        "published_date": { "type": "string", "maxLength": 40 },
        "excerpt": { "type": "string", "maxLength": 400 },
        "content": { "type": "string", "maxLength": 12000 },
        "featured_image_url": { "type": "string", "maxLength": 1000 },
        "seo_title": { "type": "string", "maxLength": 160 },
        "seo_description": { "type": "string", "maxLength": 320 },
        "is_published": { "type": "boolean" }
      },
      "required": ["title", "slug", "content", "is_published"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Student/parent enquiry submissions with duplicate prevention and PII protection.",
      "type": "object",
      "properties": {
        "student_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "parent_name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20, "pattern": "^[+0-9\\s()-]{10,20}$" },
        "email": { "type": "string", "maxLength": 120 },
        "class_level": { "type": "string", "maxLength": 80 },
        "course_name": { "type": "string", "maxLength": 160 },
        "preferred_batch": { "type": "string", "maxLength": 80 },
        "message": { "type": "string", "maxLength": 2000 },
        "source": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["new", "contacted", "enrolled", "closed"] },
        "admin_notes": { "type": "string", "maxLength": 1000 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["student_name", "phone", "status", "created_at", "updated_at"]
    },
    "AdmissionApplication": {
      "title": "AdmissionApplication",
      "description": "Formal admission applications submitted by students/parents.",
      "type": "object",
      "properties": {
        "student_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "parent_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20, "pattern": "^[+0-9\\s()-]{10,20}$" },
        "email": { "type": "string", "maxLength": 120 },
        "class_level": { "type": "string", "minLength": 1, "maxLength": 80 },
        "course_name": { "type": "string", "maxLength": 160 },
        "preferred_batch": { "type": "string", "maxLength": 80 },
        "school": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "message": { "type": "string", "maxLength": 2000 },
        "reference_code": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["pending", "verified", "confirmed", "rejected"] },
        "admin_notes": { "type": "string", "maxLength": 1000 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["student_name", "parent_name", "phone", "class_level", "status", "reference_code", "created_at", "updated_at"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin role records.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "AdminActivity": {
      "title": "AdminActivity",
      "description": "Audit log of admin content updates.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 40 },
        "entity": { "type": "string", "maxLength": 60 },
        "summary": { "type": "string", "maxLength": 300 },
        "actor_email": { "type": "string", "maxLength": 120 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "entity", "summary", "actor_email", "created_at"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Fee payment and receipt verification records managed by admin staff.",
      "type": "object",
      "properties": {
        "student_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "course_name": { "type": "string", "maxLength": 160 },
        "amount": { "type": "string", "minLength": 1, "maxLength": 40 },
        "payment_method": { "type": "string", "maxLength": 60 },
        "reference_id": { "type": "string", "maxLength": 100 },
        "paid_date": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "verified", "failed", "refunded"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["student_name", "phone", "amount", "status", "created_at", "updated_at"]
    }
  },
  "firestore": {
    "/site_settings/{settingId}": { "schema": { "$ref": "#/entities/SiteSettings" }, "description": "Global site configuration document" },
    "/nav_items/{itemId}": { "schema": { "$ref": "#/entities/NavItem" }, "description": "Header and footer navigation links" },
    "/homepage_sections/{sectionId}": { "schema": { "$ref": "#/entities/HomepageSection" }, "description": "Ordered homepage sections" },
    "/banners/{bannerId}": { "schema": { "$ref": "#/entities/Banner" }, "description": "Hero admission banners" },
    "/courses/{courseId}": { "schema": { "$ref": "#/entities/Course" }, "description": "Published and draft coaching courses" },
    "/exams/{examId}": { "schema": { "$ref": "#/entities/Exam" }, "description": "Exam schedule announcements" },
    "/lectures/{lectureId}": { "schema": { "$ref": "#/entities/Lecture" }, "description": "Video lectures" },
    "/results/{resultId}": { "schema": { "$ref": "#/entities/StudentResult" }, "description": "Verified student achievements" },
    "/faculty/{facultyId}": { "schema": { "$ref": "#/entities/FacultyMember" }, "description": "Faculty profiles" },
    "/testimonials/{testimonialId}": { "schema": { "$ref": "#/entities/Testimonial" }, "description": "Student testimonials" },
    "/gallery_albums/{albumId}": { "schema": { "$ref": "#/entities/GalleryAlbum" }, "description": "Gallery albums" },
    "/gallery_media/{mediaId}": { "schema": { "$ref": "#/entities/GalleryMedia" }, "description": "Gallery photographs" },
    "/blogs/{blogId}": { "schema": { "$ref": "#/entities/BlogPost" }, "description": "Newsroom articles and notices" },
    "/enquiries/{enquiryId}": { "schema": { "$ref": "#/entities/Enquiry" }, "description": "Private student enquiry submissions" },
    "/admissions/{admissionId}": { "schema": { "$ref": "#/entities/AdmissionApplication" }, "description": "Private admission applications" },
    "/payments/{paymentId}": { "schema": { "$ref": "#/entities/PaymentRecord" }, "description": "Admin-managed student fee payment records" },
    "/admins/{uid}": { "schema": { "$ref": "#/entities/AdminUser" }, "description": "Authorized admin users" },
    "/admin_activity/{activityId}": { "schema": { "$ref": "#/entities/AdminActivity" }, "description": "Admin activity audit log" }
  }
}
